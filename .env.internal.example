# Internal production runtime
NODE_ENV=production
APP_ENV=production
SERVICE_NAME=social-jarvis-dashboard
PUBLIC_BASE_URL=https://internal.example

# Security
AUTH_MODE=supabase

# Data source
DATA_REPOSITORY=supabase
SUPABASE_URL=
SUPABASE_SCHEMA=public
SUPABASE_SERVICE_ROLE_KEY=

# Public browser auth config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional database tooling
DATABASE_URL=

# External module wiring
SOCIAL_REPORTING_PROJECT_PATH=/opt/external/social_reporting
