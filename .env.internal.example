EDITORIAL_PLANNER_BASE_URL=http://planner:8080
EDITORIAL_PLANNER_EMAIL=
EDITORIAL_PLANNER_PASSWORD=
SOCIAL_REPORTING_PYTHON_PATH=/opt/venvs/social_reporting/bin/python

# Reporting integrations
CAMPAIGN_REVIEW_BASE_URL=
SWATIO_BASE_URL=
SWATIO_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
